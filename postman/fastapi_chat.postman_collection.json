{
  "info": {
    "name": "FastAPI Chat Assignment",
    "description": "Run **Auth > Login** once: it stores the access token in the `token` collection variable, and every request inherits it as a Bearer token.\n\nFor the Studio folder, run **Studio > Studio Login** with an admin or sub-admin account (set `admin_email` / `admin_password` first); it stores `studio_token`.\n\nCreating a conversation stores its id in `conversation_id`, so the follow-up requests work without editing URLs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "studio_token", "value": "", "type": "string" },
    { "key": "conversation_id", "value": "", "type": "string" },
    { "key": "user_id", "value": "", "type": "string" },
    { "key": "first_name", "value": "John", "type": "string" },
    { "key": "last_name", "value": "Doe", "type": "string" },
    { "key": "username", "value": "johndoe", "type": "string" },
    { "key": "email", "value": "john@example.com", "type": "string" },
    { "key": "password", "value": "password123", "type": "string" },
    { "key": "admin_email", "value": "admin@example.com", "type": "string" },
    { "key": "admin_password", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"{{first_name}}\",\n  \"last_name\": \"{{last_name}}\",\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{base_url}}/auth/signup"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "if (body.token && body.token.access_token) {",
                  "    pm.collectionVariables.set('token', body.token.access_token);",
                  "    pm.collectionVariables.set('user_id', body.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/me"
          }
        }
      ]
    },
    {
      "name": "Conversations",
      "item": [
        {
          "name": "Create Conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Conversation created', () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "if (body.id) {",
                  "    pm.collectionVariables.set('conversation_id', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My first conversation\",\n  \"message\": \"Hello, I need some help.\"\n}"
            },
            "url": "{{base_url}}/conversations"
          }
        },
        {
          "name": "List Conversations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/conversations?limit=20&offset=0",
              "host": ["{{base_url}}"],
              "path": ["conversations"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Get Conversation",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/conversations/{{conversation_id}}"
          }
        },
        {
          "name": "Add Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Any update on this?\"\n}"
            },
            "url": "{{base_url}}/conversations/{{conversation_id}}/messages"
          }
        }
      ]
    },
    {
      "name": "Studio",
      "auth": {
        "type": "bearer",
        "bearer": [
          { "key": "token", "value": "{{studio_token}}", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "Studio Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Studio login succeeded', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "if (body.token && body.token.access_token) {",
                  "    pm.collectionVariables.set('studio_token', body.token.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "List All Conversations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/studio/conversations?limit=20&offset=0",
              "host": ["{{base_url}}"],
              "path": ["studio", "conversations"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" },
                {
                  "key": "user_id",
                  "value": "{{user_id}}",
                  "description": "Optional: only this user's conversations",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get Conversation",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/studio/conversations/{{conversation_id}}"
          }
        },
        {
          "name": "Reply to Conversation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Thanks for reaching out, we are looking into it.\"\n}"
            },
            "url": "{{base_url}}/studio/conversations/{{conversation_id}}/reply"
          }
        }
      ]
    }
  ]
}
