APP_NAME=FastAPI Chat Assignment
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# URL-encode special characters in the password (e.g. @ -> %40)
DATABASE_URL=mysql+asyncmy://root:password@localhost:3306/fastapi_chat

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key-of-32-plus-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seeder accounts (python -m app.database.seeder) - change these passwords
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

SUB_ADMIN_EMAIL=subadmin@example.com
SUB_ADMIN_USERNAME=subadmin
SUB_ADMIN_PASSWORD=change-me-subadmin
